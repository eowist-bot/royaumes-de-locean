{
  "permissions": {
    "allow": [
      "Bash(gh auth *)",
      "Bash(Get-Command gh *)",
      "Bash(Get-Command git *)",
      "PowerShell(Get-Command gh -ErrorAction SilentlyContinue)",
      "PowerShell(Get-Command git -ErrorAction SilentlyContinue)",
      "PowerShell(gh auth status 2>&1)",
      "PowerShell($env:PATH = [System.Environment]::GetEnvironmentVariable\\(\"PATH\",\"Machine\"\\) + \";\" + [System.Environment]::GetEnvironmentVariable\\(\"PATH\",\"User\"\\); gh --version 2>&1)"
    ]
  }
}
